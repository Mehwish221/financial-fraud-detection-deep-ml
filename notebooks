    "print(f\"   {'Specificity':<15} {specificity:<12.4f}\")\n",
    "print(f\"   {'F1-Score':<15} {f1:<12.4f}\")\n",
    "print(f\"   {'AUCPR':<15} {aucpr:<12.4f}\")\n",
    "print(f\"   {'ROC-AUC':<15} {auc_roc:<12.4f}\")\n",
    "\n",
    "print(f\"\\n⏱️ Training Time: {best_result['training_time']:.1f} seconds\")\n",
    "\n",
    "# ============================================\n",
    "# GENERATE PR CURVE AND ROC CURVE\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"GENERATING PR CURVE AND ROC CURVE\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Calculate PR curve data\n",
    "precision_curve, recall_curve, thresholds_pr = precision_recall_curve(y_test, y_pred_proba)\n",
    "\n",
    "# Calculate ROC curve data\n",
    "fpr, tpr, thresholds_roc = roc_curve(y_test, y_pred_proba)\n",
    "\n",
    "# Create figure with 2 subplots\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# Plot 1: PR Curve (Precision-Recall Curve)\n",
    "ax1 = axes[0]\n",
    "ax1.plot(recall_curve, precision_curve, linewidth=2, color='#2E86AB', label=f'KNN (AUCPR = {aucpr:.4f})')\n",
    "ax1.fill_between(recall_curve, precision_curve, alpha=0.3, color='#2E86AB')\n",
    "\n",
    "# Add baseline (random classifier)\n",
    "baseline = y_test.sum() / len(y_test)\n",
    "ax1.axhline(y=baseline, color='red', linestyle='--', linewidth=1.5, label=f'Baseline (AUCPR = {baseline:.4f})')\n",
    "\n",
    "ax1.set_xlabel('Recall (Sensitivity)', fontsize=12, fontweight='bold')\n",
    "ax1.set_ylabel('Precision', fontsize=12, fontweight='bold')\n",
    "ax1.set_title(f'Precision-Recall Curve - KNN (k={best_k})', fontsize=14, fontweight='bold')\n",
    "ax1.legend(loc='upper right', fontsize=10)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "ax1.set_xlim([0, 1])\n",
    "ax1.set_ylim([0, 1])\n",
    "\n",
    "# Add AUCPR annotation\n",
    "ax1.text(0.55, 0.45, f'AUCPR = {aucpr:.4f}', fontsize=12, fontweight='bold',\n",
    "         bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
    "\n",
    "# Plot 2: ROC Curve\n",
    "ax2 = axes[1]\n",
    "ax2.plot(fpr, tpr, linewidth=2, color='#A23B72', label=f'KNN (AUC = {auc_roc:.4f})')\n",
    "ax2.plot([0, 1], [0, 1], 'k--', linewidth=1.5, label='Random Classifier (AUC = 0.5)')\n",
    "ax2.fill_between(fpr, tpr, alpha=0.3, color='#A23B72')\n",
