    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"GENERATING PR CURVE AND ROC CURVE\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Calculate PR curve data\n",
