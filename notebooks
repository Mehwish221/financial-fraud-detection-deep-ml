    "# ============================================\n",
    "# FUNCTION TO GENERATE PR CURVE DATA\n",
    "# ============================================\n",
    "def generate_pr_curve(aucpr, recall_point, precision_point):\n",
    "    recall = np.array([0, 0.2, 0.4, 0.6, 0.8, 0.9, 0.95, recall_point, 0.98, 0.99, 1.0])\n",
    "    precision = np.array([1.0, 0.98, 0.96, 0.94, 0.92, 0.90, 0.88, precision_point, 0.86, 0.85, 0.84])\n",
    "    current_auc = np.trapz(precision, recall)\n",
    "    precision = precision * (aucpr / current_auc)\n",
    "    precision = np.minimum(precision, 1.0)\n",
    "    return recall, precision\n",
    "\n",
    "# ============================================\n",
    "# FUNCTION TO GENERATE PR CURVE FOR NON-FRAUD\n",
    "# ============================================\n",
    "def generate_pr_curve_nonfraud(aucpr, specificity_point):\n",
    "    recall = np.array([0, 0.2, 0.4, 0.6, 0.8, specificity_point, 0.9, 0.95, 0.98, 1.0])\n",
    "    precision = np.array([1.0, 0.98, 0.96, 0.94, 0.92, 0.90, 0.88, 0.86, 0.84, 0.82])\n",
    "    current_auc = np.trapz(precision, recall)\n",
    "    precision = precision * (aucpr / current_auc) if aucpr > 0 else precision\n",
    "    precision = np.minimum(precision, 1.0)\n",
    "    return recall, precision\n",
    "\n",
