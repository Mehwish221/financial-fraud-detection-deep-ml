    "    df = df.drop(columns=['fraud_type'])\n",
    "    print(\"✅ Dropped 'fraud_type' column (96.4% null values - not useful)\")\n",
    "\n",
    "# For time_since_last_transaction (17.9% null) - fill with median\n",
    "if 'time_since_last_transaction' in df.columns:\n",
    "    median_value = df['time_since_last_transaction'].median()\n",
    "    df['time_since_last_transaction'].fillna(median_value, inplace=True)\n",
    "    print(f\"✅ Filled 'time_since_last_transaction' null values with median: {median_value:.2f}\")\n",
    "\n",
    "# Check if any null values remain\n",
    "print(f\"\\nRemaining null values: {df.isnull().sum().sum()}\")\n",
    "print(f\"New shape: {df.shape}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"STEP 2: Removing Outliers (IQR method)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Select only numeric columns for outlier removal\n",
    "numeric_cols = df.select_dtypes(include=['int64', 'float64']).columns\n",
    "print(f\"Numeric columns to process: {numeric_cols.tolist()}\")\n",
    "\n",
    "initial_shape = df.shape\n",
    "outliers_removed_total = 0\n",
    "\n",
    "for col in numeric_cols:\n",
    "    before = len(df)\n",
    "    \n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    \n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "    \n",
    "    # Remove outliers\n",
    "    df = df[(df[col] >= lower_bound) & (df[col] <= upper_bound)]\n",
    "    \n",
    "    outliers_removed = before - len(df)\n",
    "    outliers_removed_total += outliers_removed\n",
    "    \n",
    "    if outliers_removed > 0:\n",
    "        print(f\"  {col}: removed {outliers_removed:,} outliers\")\n",
    "\n",
    "print(f\"\\n✅ Outlier removal complete:\")\n",
    "print(f\"   Original rows: {initial_shape[0]:,}\")\n",
    "print(f\"   Rows after removal: {df.shape[0]:,}\")\n",
    "print(f\"   Total outliers removed: {outliers_removed_total:,}\")\n",
    "print(f\"   Percentage kept: {df.shape[0]/initial_shape[0]*100:.2f}%\")\n",
    "\n",
