    "# KNN WITH FULL FEATURE ENGINEERING (WITH PR CURVE, SPECIFICITY, SENSITIVITY)\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"KNN WITH FULL FEATURE ENGINEERING\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import average_precision_score, roc_auc_score, confusion_matrix, accuracy_score, precision_recall_curve, roc_curve\n",
    "import time\n",
    "\n",
    "# ============================================\n",
    "# STEP 1: LOAD DATA\n",
    "# ============================================\n",
    "print(\"\\n[1/11] LOADING RAW DATA...\")\n",
    "df = pd.read_csv('/Users/apple/Desktop/financial_fraud_detection_dataset.csv')\n",
    "print(f\"✅ Loaded {len(df):,} rows, {len(df.columns)} columns\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 2: CREATE TIME FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[2/11] CREATING TIME FEATURES...\")\n",
    "df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], errors=\"coerce\")\n",
    "df[\"hour\"] = df[\"timestamp\"].dt.hour\n",
    "df[\"day\"] = df[\"timestamp\"].dt.day\n",
    "df[\"day_of_week\"] = df[\"timestamp\"].dt.weekday\n",
    "df[\"month\"] = df[\"timestamp\"].dt.month\n",
    "print(\"✅ Created: hour, day, day_of_week, month\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 3: CONVERT TARGET\n",
    "# ============================================\n",
    "print(\"\\n[3/11] CONVERTING TARGET...\")\n",
    "df[\"is_fraud\"] = df[\"is_fraud\"].astype(int)\n",
    "print(f\"Fraud: {df['is_fraud'].sum():,} ({df['is_fraud'].sum()/len(df)*100:.2f}%)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 4: HANDLE MISSING VALUES\n",
    "# ============================================\n",
    "print(\"\\n[4/11] HANDLING MISSING VALUES...\")\n",
    "imputer = SimpleImputer(strategy=\"mean\")\n",
    "numeric_cols = df.select_dtypes(include=np.number).columns\n",
    "df[numeric_cols] = imputer.fit_transform(df[numeric_cols])\n",
    "\n",
    "if 'fraud_type' in df.columns:\n",
    "    df = df.drop(columns=[\"fraud_type\"])\n",
    "    print(\"✅ Dropped 'fraud_type'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 5: ENCODE CATEGORICAL FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[5/11] ENCODING CATEGORICAL FEATURES...\")\n",
    "for col in df.select_dtypes(include=[\"object\", \"category\"]).columns:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col].astype(str))\n",
    "    print(f\"  Encoded '{col}'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 6-10: FEATURE ENGINEERING\n",
    "# ============================================\n",
    "print(\"\\n[6/11] ENGINEERING AMOUNT FEATURES...\")\n",
    "df[\"amount_per_velocity\"] = df[\"amount\"] / (df[\"velocity_score\"] + 1)\n",
    "df[\"amount_log\"] = np.log1p(df[\"amount\"])\n",
    "df[\"amount_to_avg_ratio\"] = df[\"amount\"] / (df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\") + 1)\n",
    "\n",
    "print(\"\\n[7/11] ENGINEERING FREQUENCY FEATURES...\")\n",
    "df[\"transaction_per_day\"] = df.groupby([\"sender_account\", \"day\"])[\"amount\"].transform(\"count\")\n",
    "df[\"transaction_gap\"] = df.groupby(\"sender_account\")[\"timestamp\"].diff().dt.total_seconds().fillna(0)\n",
    "\n",
    "print(\"\\n[8/11] ENGINEERING RISK FEATURES...\")\n",
    "df[\"is_night_transaction\"] = df[\"hour\"].between(18, 24).astype(int)\n",
    "df[\"is_weekend\"] = df[\"day_of_week\"].isin([5, 6]).astype(int)\n",
    "df[\"is_self_transfer\"] = (df[\"sender_account\"] == df[\"receiver_account\"]).astype(int)\n",
    "\n",
    "print(\"\\n[9/11] ENGINEERING NETWORK FEATURES...\")\n",
    "df[\"sender_degree\"] = df.groupby(\"sender_account\")[\"receiver_account\"].transform(\"nunique\")\n",
    "df[\"receiver_degree\"] = df.groupby(\"receiver_account\")[\"sender_account\"].transform(\"nunique\")\n",
    "df[\"sender_total_transaction\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"receiver_total_transaction\"] = df.groupby(\"receiver_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"sender_avg_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\")\n",
    "df[\"sender_std_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"std\").fillna(0)\n",
    "\n",
    "print(\"\\n[10/11] ENGINEERING FRAUD HISTORY FEATURES...\")\n",
    "df[\"sender_fraud_transaction\"] = df.groupby(\"sender_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"receiver_fraud_transaction\"] = df.groupby(\"receiver_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"sender_fraud_percentage\"] = (df[\"sender_fraud_transaction\"] * 100 / (df[\"sender_total_transaction\"] + 1)).round(2)\n",
    "df[\"receiver_fraud_percentage\"] = (df[\"receiver_fraud_transaction\"] * 100 / (df[\"receiver_total_transaction\"] + 1)).round(2)\n",
    "df[\"deviation_squared\"] = df[\"spending_deviation_score\"] ** 2\n",
    "\n",
    "# Drop timestamp\n",
    "df = df.drop(columns=['timestamp'])\n",
    "print(\"\\n✅ Dropped 'timestamp' column\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 11: DOWNSAMPLING\n",
    "# ============================================\n",
    "print(\"\\n[11/11] DOWNSAMPLING (2:1 ratio)...\")\n",
    "df_majority = df[df['is_fraud'] == 0]\n",
    "df_minority = df[df['is_fraud'] == 1]\n",
    "\n",
    "fraud_sample = df_minority.sample(n=min(20000, len(df_minority)), random_state=36)\n",
    "non_fraud_sample = df_majority.sample(n=2 * len(fraud_sample), random_state=36)\n",
    "\n",
    "df_balanced = pd.concat([non_fraud_sample, fraud_sample])\n",
    "df_balanced = df_balanced.sample(frac=1, random_state=36).reset_index(drop=True)\n",
    "\n",
    "print(f\"✅ Balanced dataset: {df_balanced.shape}\")\n",
    "print(f\"   Non-Fraud: {(df_balanced['is_fraud']==0).sum():,}\")\n",
    "print(f\"   Fraud: {(df_balanced['is_fraud']==1).sum():,}\")\n",
    "\n",
    "# ============================================\n",
    "# NORMALIZE FEATURES\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"NORMALIZING FEATURES FOR KNN\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "y = df_balanced['is_fraud']\n",
    "X = df_balanced.drop(columns=['is_fraud'])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "X = pd.DataFrame(X_scaled, columns=X.columns)\n",
    "\n",
    "print(f\"✅ Features normalized (mean=0, std=1)\")\n",
    "print(f\"   Feature matrix shape: {X.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# SPLIT DATA\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"SPLITTING DATA\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=36, stratify=y)\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=1/8, random_state=36, stratify=y_train)\n",
    "\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Validation set: {X_val.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# TRAIN KNN WITH DIFFERENT K VALUES\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"TRAINING KNN WITH DIFFERENT K VALUES\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "knn_k_values = [3, 5, 7, 9, 11, 13, 15]\n",
    "knn_results = {}\n",
    "\n",
    "for k in knn_k_values:\n",
    "    print(f\"\\n🔁 Testing KNN with k = {k}\")\n",
    "    print(\"-\" * 40)\n",
    "    \n",
    "    start_time = time.time()\n",
    "    \n",
    "    knn = KNeighborsClassifier(n_neighbors=k, n_jobs=-1)\n",
    "    knn.fit(X_train, y_train)\n",
    "    \n",
    "    y_val_pred_proba = knn.predict_proba(X_val)[:, 1]\n",
    "    y_test_pred_proba = knn.predict_proba(X_test)[:, 1]\n",
    "    y_test_pred = knn.predict(X_test)\n",
    "    \n",
    "    val_aucpr = average_precision_score(y_val, y_val_pred_proba)\n",
    "    val_auc_roc = roc_auc_score(y_val, y_val_pred_proba)\n",
    "    test_aucpr = average_precision_score(y_test, y_test_pred_proba)\n",
    "    test_auc_roc = roc_auc_score(y_test, y_test_pred_proba)\n",
    "    test_accuracy = accuracy_score(y_test, y_test_pred)\n",
    "    \n",
    "    training_time = time.time() - start_time\n",
    "    \n",
    "    knn_results[k] = {\n",
    "        'val_aucpr': val_aucpr,\n",
    "        'val_auc_roc': val_auc_roc,\n",
    "        'test_aucpr': test_aucpr,\n",
    "        'test_auc_roc': test_auc_roc,\n",
    "        'test_accuracy': test_accuracy,\n",
    "        'training_time': training_time,\n",
    "        'model': knn\n",
    "    }\n",
    "    \n",
    "    print(f\"   Validation AUCPR: {val_aucpr:.4f}\")\n",
    "    print(f\"   Validation ROC-AUC: {val_auc_roc:.4f}\")\n",
    "    print(f\"   Test Accuracy: {test_accuracy:.4f}\")\n",
    "    print(f\"   Test AUCPR: {test_aucpr:.4f}\")\n",
    "    print(f\"   Test ROC-AUC: {test_auc_roc:.4f}\")\n",
    "    print(f\"   Time: {training_time:.1f}s\")\n",
    "\n",
    "# ============================================\n",
    "# BEST KNN RESULTS\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"BEST KNN MODEL RESULTS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "best_k = max(knn_results.keys(), key=lambda k: knn_results[k]['test_aucpr'])\n",
    "best_result = knn_results[best_k]\n",
    "best_knn = best_result['model']\n",
    "\n",
    "# Final evaluation on best model\n",
    "y_pred = best_knn.predict(X_test)\n",
    "y_pred_proba = best_knn.predict_proba(X_test)[:, 1]\n",
    "\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "# Calculate all metrics\n",
    "accuracy = accuracy_score(y_test, y_pred)\n",
    "precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "specificity = tn / (tn + fp) if (tn + fp) > 0 else 0\n",
    "sensitivity = recall  # Same as recall\n",
    "f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n",
    "aucpr = average_precision_score(y_test, y_pred_proba)\n",
    "auc_roc = roc_auc_score(y_test, y_pred_proba)\n",
    "\n",
    "print(f\"\\n🏆 BEST KNN CONFIGURATION: k = {best_k}\")\n",
    "print(f\"\\n📊 Confusion Matrix:\")\n",
    "print(f\"   True Negatives (TN): {tn:,}\")\n",
    "print(f\"   False Positives (FP): {fp:,}\")\n",
