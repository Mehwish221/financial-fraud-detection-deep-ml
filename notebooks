    "# Apply Label Encoding\n",
    "print(\"\\n🔄 Applying Label Encoding...\")\n",
    "for col in object_columns:\n",
    "    le = LabelEncoder()\n",
    "    df_encoded[col] = le.fit_transform(df[col].astype(str))\n",
    "    print(f\"   ✅ Encoded '{col}'\")\n",
