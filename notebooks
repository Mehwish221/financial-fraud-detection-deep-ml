    "df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], errors=\"coerce\")\n",
    "df[\"hour\"] = df[\"timestamp\"].dt.hour\n",
    "df[\"day\"] = df[\"timestamp\"].dt.day\n",
    "df[\"day_of_week\"] = df[\"timestamp\"].dt.weekday\n",
    "df[\"month\"] = df[\"timestamp\"].dt.month\n",
    "df[\"is_night_transaction\"] = ((df[\"hour\"] >= 18) & (df[\"hour\"] <= 23)).astype(int)\n",
    "df[\"is_weekend\"] = (df[\"day_of_week\"].isin([5, 6])).astype(int)\n",
    "print(\"✅ Created: hour, day, day_of_week, month, is_night, is_weekend\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 3: CONVERT TARGET\n",
    "# ============================================\n",
    "print(\"\\n[3/10] CONVERTING TARGET...\")\n",
    "df[\"is_fraud\"] = df[\"is_fraud\"].astype(int)\n",
    "fraud_count = df['is_fraud'].sum()\n",
    "print(f\"Fraud: {fraud_count:,} ({fraud_count/len(df)*100:.2f}%)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 4: HANDLE MISSING VALUES\n",
    "# ============================================\n",
    "print(\"\\n[4/10] HANDLING MISSING VALUES...\")\n",
    "if 'fraud_type' in df.columns:\n",
    "    df = df.drop(columns=[\"fraud_type\"])\n",
    "    print(\"✅ Dropped 'fraud_type'\")\n",
    "\n",
    "if 'time_since_last_transaction' in df.columns:\n",
    "    median_val = df['time_since_last_transaction'].median()\n",
    "    df['time_since_last_transaction'] = df['time_since_last_transaction'].fillna(median_val)\n",
    "    print(f\"✅ Filled missing with median: {median_val:.2f}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 5: ENCODE CATEGORICAL FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[5/10] ENCODING CATEGORICAL FEATURES...\")\n",
    "for col in df.select_dtypes(include=[\"object\", \"category\"]).columns:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col].astype(str))\n",
    "    print(f\"  Encoded '{col}'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 6: FEATURE ENGINEERING\n",
    "# ============================================\n",
    "print(\"\\n[6/10] FEATURE ENGINEERING...\")\n",
    "\n",
    "# Amount features\n",
    "df[\"amount_log\"] = np.log1p(df[\"amount\"])\n",
    "df[\"amount_per_velocity\"] = df[\"amount\"] / (df[\"velocity_score\"] + 1)\n",
    "df[\"amount_to_avg_ratio\"] = df[\"amount\"] / (df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\") + 1)\n",
    "\n",
    "# Frequency features\n",
    "df[\"transaction_per_day\"] = df.groupby([\"sender_account\", \"day\"])[\"amount\"].transform(\"count\")\n",
    "df[\"transaction_gap\"] = df.groupby(\"sender_account\")[\"timestamp\"].diff().dt.total_seconds().fillna(0)\n",
    "\n",
    "# Risk features\n",
    "df[\"is_self_transfer\"] = (df[\"sender_account\"] == df[\"receiver_account\"]).astype(int)\n",
    "df[\"deviation_squared\"] = df[\"spending_deviation_score\"] ** 2\n",
    "\n",
    "# Network features\n",
    "df[\"sender_degree\"] = df.groupby(\"sender_account\")[\"receiver_account\"].transform(\"nunique\")\n",
    "df[\"receiver_degree\"] = df.groupby(\"receiver_account\")[\"sender_account\"].transform(\"nunique\")\n",
    "df[\"sender_total_transaction\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"receiver_total_transaction\"] = df.groupby(\"receiver_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"sender_avg_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\")\n",
    "df[\"sender_std_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"std\").fillna(0)\n",
    "\n",
    "# Fraud history features\n",
    "df[\"sender_fraud_transaction\"] = df.groupby(\"sender_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"receiver_fraud_transaction\"] = df.groupby(\"receiver_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"sender_fraud_percentage\"] = (df[\"sender_fraud_transaction\"] * 100 / (df[\"sender_total_transaction\"] + 1)).round(2)\n",
    "df[\"receiver_fraud_percentage\"] = (df[\"receiver_fraud_transaction\"] * 100 / (df[\"receiver_total_transaction\"] + 1)).round(2)\n",
    "\n",
    "# Drop timestamp\n",
    "df = df.drop(columns=['timestamp'])\n",
    "print(\"✅ Created 20+ engineered features\")\n",
    "print(f\"✅ Total features: {len(df.columns)}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 7: DOWNSAMPLING (Smaller sample for LSTM)\n",
    "# ============================================\n",
    "print(\"\\n[7/10] DOWNSAMPLING (2:1 ratio for LSTM)...\")\n",
    "df_majority = df[df['is_fraud'] == 0]\n",
    "df_minority = df[df['is_fraud'] == 1]\n",
    "\n",
    "# Use 10k fraud, 20k non-fraud = 30k total (for LSTM speed)\n",
    "fraud_sample = df_minority.sample(n=min(10000, len(df_minority)), random_state=36)\n",
    "non_fraud_sample = df_majority.sample(n=2 * len(fraud_sample), random_state=36)\n",
    "\n",
    "df_balanced = pd.concat([non_fraud_sample, fraud_sample])\n",
    "df_balanced = df_balanced.sample(frac=1, random_state=36).reset_index(drop=True)\n",
    "\n",
    "print(f\"✅ Balanced dataset: {df_balanced.shape}\")\n",
    "print(f\"   Non-Fraud: {(df_balanced['is_fraud']==0).sum():,}\")\n",
    "print(f\"   Fraud: {(df_balanced['is_fraud']==1).sum():,}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 8: NORMALIZE AND PREPARE DATA\n",
    "# ============================================\n",
    "print(\"\\n[8/10] NORMALIZING FEATURES FOR LSTM...\")\n",
    "\n",
    "y = df_balanced['is_fraud']\n",
    "X = df_balanced.drop(columns=['is_fraud'])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "X = pd.DataFrame(X_scaled, columns=X.columns)\n",
    "\n",
    "print(f\"✅ Features normalized: {X.shape}\")\n",
    "\n",
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=36, stratify=y)\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=1/8, random_state=36, stratify=y_train)\n",
    "\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Validation set: {X_val.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# RESHAPE FOR LSTM (samples, timesteps, features)\n",
    "X_train_lstm = X_train.values.reshape(X_train.shape[0], 1, X_train.shape[1])\n",
    "X_val_lstm = X_val.values.reshape(X_val.shape[0], 1, X_val.shape[1])\n",
    "X_test_lstm = X_test.values.reshape(X_test.shape[0], 1, X_test.shape[1])\n",
    "\n",
    "print(f\"✅ Reshaped for LSTM: {X_train_lstm.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 9: BUILD AND TRAIN LSTM MODEL\n",
    "# ============================================\n",
    "print(\"\\n[9/10] BUILDING AND TRAINING LSTM MODEL...\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Calculate class weights for imbalance\n",
    "total = len(y_train)\n",
    "fraud_ratio = sum(y_train) / total\n",
    "class_weight = {0: 1.0, 1: (1/fraud_ratio) * 0.5}\n",
    "\n",
    "# Build LSTM model\n",
    "model = Sequential([\n",
    "    Input(shape=(1, X_train.shape[1])),\n",
    "    \n",
    "    LSTM(64, return_sequences=True, activation='tanh'),\n",
    "    Dropout(0.3),\n",
    "    BatchNormalization(),\n",
    "    \n",
    "    LSTM(32, return_sequences=False, activation='tanh'),\n",
    "    Dropout(0.3),\n",
    "    BatchNormalization(),\n",
    "    \n",
    "    Dense(16, activation='relu'),\n",
    "    Dropout(0.2),\n",
    "    Dense(8, activation='relu'),\n",
    "    Dropout(0.2),\n",
    "    \n",
    "    Dense(1, activation='sigmoid')\n",
    "])\n",
    "\n",
    "# Compile model\n",
    "model.compile(\n",
    "    optimizer=Adam(learning_rate=0.001),\n",
    "    loss='binary_crossentropy',\n",
    "    metrics=['accuracy', tf.keras.metrics.AUC(name='auc')]\n",
    ")\n",
    "\n",
    "model.summary()\n",
    "\n",
    "# Callbacks\n",
    "early_stop = EarlyStopping(\n",
    "    monitor='val_auc',\n",
    "    mode='max',\n",
    "    patience=15,\n",
    "    restore_best_weights=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor='val_loss',\n",
    "    factor=0.5,\n",
    "    patience=5,\n",
    "    min_lr=0.00001,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Train model\n",
    "print(\"\\n🔄 Training LSTM model...\")\n",
    "start_time = time.time()\n",
    "\n",
    "history = model.fit(\n",
    "    X_train_lstm, y_train,\n",
    "    validation_data=(X_val_lstm, y_val),\n",
    "    epochs=50,\n",
    "    batch_size=32,\n",
    "    class_weight=class_weight,\n",
    "    callbacks=[early_stop, reduce_lr],\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "training_time = time.time() - start_time\n",
    "print(f\"\\n✅ Training complete in {training_time/60:.1f} minutes\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 10: EVALUATE LSTM MODEL\n",
    "# ============================================\n",
    "print(\"\\n[10/10] EVALUATING LSTM MODEL ON TEST SET\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Predict\n",
    "y_pred_proba = model.predict(X_test_lstm, verbose=0).flatten()\n",
    "y_pred = (y_pred_proba > 0.5).astype(int)\n",
    "\n",
    "# Calculate metrics\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "accuracy = accuracy_score(y_test, y_pred)\n",
    "precision = precision_score(y_test, y_pred)\n",
    "recall = recall_score(y_test, y_pred)\n",
    "specificity = tn / (tn + fp) if (tn + fp) > 0 else 0\n",
    "f1 = f1_score(y_test, y_pred)\n",
    "auc_roc = roc_auc_score(y_test, y_pred_proba)\n",
    "auprc = average_precision_score(y_test, y_pred_proba)\n",
    "\n",
    "print(f\"\\n📊 Confusion Matrix:\")\n",
    "print(f\"   True Negatives (TN): {tn:,}\")\n",
    "print(f\"   False Positives (FP): {fp:,}\")\n",
    "print(f\"   False Negatives (FN): {fn:,}\")\n",
    "print(f\"   True Positives (TP): {tp:,}\")\n",
    "\n",
    "print(f\"\\n📈 PERFORMANCE METRICS:\")\n",
    "print(f\"   {'Accuracy':<20} {accuracy:<12.4f}\")\n",
    "print(f\"   {'Precision':<20} {precision:<12.4f}\")\n",
    "print(f\"   {'Recall (Sensitivity)':<20} {recall:<12.4f}\")\n",
    "print(f\"   {'Specificity':<20} {specificity:<12.4f}\")\n",
    "print(f\"   {'F1-Score':<20} {f1:<12.4f}\")\n",
    "print(f\"   {'ROC-AUC':<20} {auc_roc:<12.4f}\")\n",
    "print(f\"   {'AUCPR':<20} {auprc:<12.4f}\")\n",
    "\n",
    "print(f\"\\n⏱️ Training Time: {training_time/60:.1f} minutes\")\n",
    "\n",
    "# ============================================\n",
    "# VISUALIZATIONS\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"GENERATING VISUALIZATIONS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# FIGURE 1: Training History\n",
    "fig1, axes1 = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Loss curve\n",
    "ax1 = axes1[0, 0]\n",
    "ax1.plot(history.history['loss'], label='Train Loss', linewidth=2, color='#2E86AB')\n",
