    "# Accuracy curve\n",
    "ax2 = axes1[0, 1]\n",
    "ax2.plot(history.history['accuracy'], label='Train Accuracy', linewidth=2, color='#2E86AB')\n",
    "ax2.plot(history.history['val_accuracy'], label='Validation Accuracy', linewidth=2, color='#A23B72')\n",
    "ax2.set_xlabel('Epoch', fontsize=12)\n",
    "ax2.set_ylabel('Accuracy', fontsize=12)\n",
    "ax2.set_title('LSTM Training - Accuracy Curve', fontsize=14, fontweight='bold')\n",
    "ax2.legend()\n",
    "ax2.grid(True, alpha=0.3)\n",
