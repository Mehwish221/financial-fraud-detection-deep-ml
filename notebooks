   "source": [
    "# SVM WITH LINEAR AND POLYNOMIAL KERNEL (Degree 1, 2, 3)\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"SVM WITH LINEAR AND POLYNOMIAL KERNELS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.metrics import (accuracy_score, precision_score, recall_score, f1_score,\n",
    "                             roc_auc_score, average_precision_score, confusion_matrix,\n",
    "                             roc_curve, precision_recall_curve)\n",
    "import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set random seed for reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "# ============================================\n",
    "# STEP 1: LOAD DATA\n",
    "# ============================================\n",
    "print(\"\\n[1/8] LOADING RAW DATA...\")\n",
    "df = pd.read_csv('/Users/apple/Desktop/financial_fraud_detection_dataset.csv')\n",
    "print(f\"✅ Loaded {len(df):,} rows, {len(df.columns)} columns\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 2: CREATE TIME FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[2/8] CREATING TIME FEATURES...\")\n",
    "df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], errors=\"coerce\")\n",
    "df[\"hour\"] = df[\"timestamp\"].dt.hour\n",
    "df[\"day\"] = df[\"timestamp\"].dt.day\n",
    "df[\"day_of_week\"] = df[\"timestamp\"].dt.weekday\n",
    "df[\"month\"] = df[\"timestamp\"].dt.month\n",
    "df[\"is_night_transaction\"] = ((df[\"hour\"] >= 18) & (df[\"hour\"] <= 23)).astype(int)\n",
    "df[\"is_weekend\"] = (df[\"day_of_week\"].isin([5, 6])).astype(int)\n",
    "print(\"✅ Created: hour, day, day_of_week, month, is_night, is_weekend\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 3: CONVERT TARGET\n",
    "# ============================================\n",
    "print(\"\\n[3/8] CONVERTING TARGET...\")\n",
    "df[\"is_fraud\"] = df[\"is_fraud\"].astype(int)\n",
    "print(f\"Fraud: {df['is_fraud'].sum():,} ({df['is_fraud'].sum()/len(df)*100:.2f}%)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 4: HANDLE MISSING VALUES\n",
    "# ============================================\n",
    "print(\"\\n[4/8] HANDLING MISSING VALUES...\")\n",
    "if 'fraud_type' in df.columns:\n",
    "    df = df.drop(columns=[\"fraud_type\"])\n",
    "    print(\"✅ Dropped 'fraud_type'\")\n",
    "\n",
    "if 'time_since_last_transaction' in df.columns:\n",
    "    median_val = df['time_since_last_transaction'].median()\n",
    "    df['time_since_last_transaction'] = df['time_since_last_transaction'].fillna(median_val)\n",
    "    print(f\"✅ Filled missing with median: {median_val:.2f}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 5: FEATURE ENGINEERING (Simplified for SVM)\n",
    "# ============================================\n",
    "print(\"\\n[5/8] FEATURE ENGINEERING...\")\n",
    "\n",
    "# Amount features\n",
    "df[\"amount_log\"] = np.log1p(df[\"amount\"])\n",
    "df[\"amount_per_velocity\"] = df[\"amount\"] / (df[\"velocity_score\"] + 1)\n",
    "\n",
    "# Network features (simplified)\n",
    "df[\"sender_total_transaction\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"sender_fraud_transaction\"] = df.groupby(\"sender_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"sender_fraud_percentage\"] = (df[\"sender_fraud_transaction\"] * 100 / (df[\"sender_total_transaction\"] + 1)).round(2)\n",
    "\n",
    "# Risk features\n",
    "df[\"is_self_transfer\"] = (df[\"sender_account\"] == df[\"receiver_account\"]).astype(int)\n",
    "\n",
    "print(\"✅ Created: amount_log, amount_per_velocity, sender_fraud_%, is_self_transfer\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 6: ENCODE CATEGORICAL FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[6/8] ENCODING CATEGORICAL FEATURES...\")\n",
    "for col in df.select_dtypes(include=[\"object\", \"category\"]).columns:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col].astype(str))\n",
    "    print(f\"  Encoded '{col}'\")\n",
    "\n",
    "# Drop timestamp\n",
    "df = df.drop(columns=['timestamp'])\n",
    "print(\"✅ Dropped 'timestamp'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 7: DOWNSAMPLING (2:1 ratio for speed)\n",
    "# ============================================\n",
    "print(\"\\n[7/8] DOWNSAMPLING (2:1 ratio)...\")\n",
    "df_majority = df[df['is_fraud'] == 0]\n",
    "df_minority = df[df['is_fraud'] == 1]\n",
    "\n",
    "fraud_sample = df_minority.sample(n=min(15000, len(df_minority)), random_state=36)\n",
    "non_fraud_sample = df_majority.sample(n=2 * len(fraud_sample), random_state=36)\n",
    "\n",
    "df_balanced = pd.concat([non_fraud_sample, fraud_sample])\n",
    "df_balanced = df_balanced.sample(frac=1, random_state=36).reset_index(drop=True)\n",
    "\n",
    "print(f\"✅ Balanced dataset: {df_balanced.shape}\")\n",
    "print(f\"   Non-Fraud: {(df_balanced['is_fraud']==0).sum():,}\")\n",
    "print(f\"   Fraud: {(df_balanced['is_fraud']==1).sum():,}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 8: NORMALIZE FEATURES (Critical for SVM)\n",
    "# ============================================\n",
    "print(\"\\n[8/8] NORMALIZING FEATURES FOR SVM...\")\n",
    "\n",
    "y = df_balanced['is_fraud']\n",
    "X = df_balanced.drop(columns=['is_fraud'])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "print(f\"✅ Features normalized: {X_scaled.shape}\")\n",
    "\n",
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=36, stratify=y)\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=1/8, random_state=36, stratify=y_train)\n",
    "\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Validation set: {X_val.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# TRAIN SVM WITH DIFFERENT KERNELS\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"TRAINING SVM WITH LINEAR AND POLYNOMIAL KERNELS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Define models to test\n",
    "svm_models = [\n",
    "    {'name': 'Linear SVM', 'kernel': 'linear', 'degree': 1, 'C': 1.0},\n",
    "    {'name': 'Polynomial SVM (degree=1)', 'kernel': 'poly', 'degree': 1, 'C': 1.0},\n",
    "    {'name': 'Polynomial SVM (degree=2)', 'kernel': 'poly', 'degree': 2, 'C': 1.0},\n",
    "    {'name': 'Polynomial SVM (degree=3)', 'kernel': 'poly', 'degree': 3, 'C': 1.0},\n",
    "]\n",
    "\n",
    "results = {}\n",
    "\n",
    "for model_config in svm_models:\n",
    "    print(f\"\\n{'─'*50}\")\n",
    "    print(f\"🔁 Training {model_config['name']}\")\n",
    "    print(f\"   Kernel: {model_config['kernel']}, Degree: {model_config['degree']}, C: {model_config['C']}\")\n",
    "    print(\"-\" * 40)\n",
    "    \n",
    "    start_time = time.time()\n",
    "    \n",
    "    # Train SVM\n",
    "    svm = SVC(\n",
    "        kernel=model_config['kernel'],\n",
    "        degree=model_config['degree'],\n",
    "        C=model_config['C'],\n",
    "        probability=True,\n",
    "        random_state=36,\n",
    "        class_weight='balanced'\n",
    "    )\n",
    "    svm.fit(X_train, y_train)\n",
    "    \n",
    "    training_time = time.time() - start_time\n",
    "    \n",
    "    # Predictions\n",
    "    y_pred = svm.predict(X_test)\n",
    "    y_pred_proba = svm.predict_proba(X_test)[:, 1]\n",
    "    \n",
    "    # Calculate metrics\n",
    "    accuracy = accuracy_score(y_test, y_pred)\n",
    "    precision = precision_score(y_test, y_pred)\n",
    "    recall = recall_score(y_test, y_pred)\n",
    "    specificity = recall_score(y_test, y_pred, pos_label=0)  # For negative class\n",
    "    f1 = f1_score(y_test, y_pred)\n",
    "    auc_roc = roc_auc_score(y_test, y_pred_proba)\n",
    "    auprc = average_precision_score(y_test, y_pred_proba)\n",
    "    \n",
    "    # Confusion matrix\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    tn, fp, fn, tp = cm.ravel()\n",
    "    \n",
    "    # Store results\n",
    "    results[model_config['name']] = {\n",
    "        'accuracy': accuracy,\n",
    "        'precision': precision,\n",
    "        'recall': recall,\n",
    "        'specificity': specificity,\n",
    "        'f1_score': f1,\n",
    "        'auc_roc': auc_roc,\n",
    "        'auprc': auprc,\n",
    "        'training_time': training_time,\n",
    "        'confusion_matrix': cm,\n",
    "        'y_pred_proba': y_pred_proba,\n",
    "        'model': svm\n",
    "    }\n",
    "    \n",
    "    # Print results\n",
    "    print(f\"\\n   📊 RESULTS for {model_config['name']}:\")\n",
    "    print(f\"   {'Accuracy':<15} {accuracy:<12.4f}\")\n",
    "    print(f\"   {'Precision':<15} {precision:<12.4f}\")\n",
    "    print(f\"   {'Recall (Sensitivity)':<15} {recall:<12.4f}\")\n",
    "    print(f\"   {'Specificity':<15} {specificity:<12.4f}\")\n",
    "    print(f\"   {'F1-Score':<15} {f1:<12.4f}\")\n",
    "    print(f\"   {'ROC-AUC':<15} {auc_roc:<12.4f}\")\n",
    "    print(f\"   {'AUCPR':<15} {auprc:<12.4f}\")\n",
    "    print(f\"   {'Training Time':<15} {training_time:<12.1f}s\")\n",
    "    \n",
    "    print(f\"\\n   📈 Confusion Matrix:\")\n",
    "    print(f\"   True Negatives: {tn:,}\")\n",
    "    print(f\"   False Positives: {fp:,}\")\n",
    "    print(f\"   False Negatives: {fn:,}\")\n",
    "    print(f\"   True Positives: {tp:,}\")\n",
    "\n",
    "# ============================================\n",
    "# FIND BEST MODEL\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"BEST SVM MODEL COMPARISON\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "best_model = max(results.keys(), key=lambda k: results[k]['auprc'])\n",
    "best_result = results[best_model]\n",
    "\n",
    "print(f\"\\n🏆 BEST SVM MODEL: {best_model}\")\n",
    "print(f\"   AUCPR: {best_result['auprc']:.4f}\")\n",
    "print(f\"   ROC-AUC: {best_result['auc_roc']:.4f}\")\n",
    "print(f\"   Accuracy: {best_result['accuracy']:.4f}\")\n",
    "print(f\"   Recall: {best_result['recall']:.4f}\")\n",
    "print(f\"   Precision: {best_result['precision']:.4f}\")\n",
