    "# COMPLETE PREPROCESSING PIPELINE - Run this from start\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "import joblib\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"COMPLETE FRAUD DETECTION PREPROCESSING PIPELINE\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# ============================================\n",
    "# STEP 1: LOAD DATA\n",
    "# ============================================\n",
    "print(\"\\n[1/7] LOADING DATA...\")\n",
    "df = pd.read_csv('/Users/apple/Desktop/financial_fraud_detection_dataset.csv')\n",
    "print(f\"✅ Loaded {len(df):,} rows, {len(df.columns)} columns\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 2: HANDLE NULL VALUES\n",
    "# ============================================\n",
    "print(\"\\n[2/7] HANDLING NULL VALUES...\")\n",
    "\n",
    "# Check nulls before\n",
    "null_counts = df.isnull().sum()\n",
    "print(f\"Null values before: {null_counts.sum():,}\")\n",
    "\n",
    "# Drop fraud_type (96.4% null - useless column)\n",
    "if 'fraud_type' in df.columns:\n",
    "    df = df.drop(columns=['fraud_type'])\n",
    "    print(\"✅ Dropped 'fraud_type' (96.4% null)\")\n",
    "\n",
    "# Fill time_since_last_transaction nulls with median\n",
    "if 'time_since_last_transaction' in df.columns:\n",
    "    median_val = df['time_since_last_transaction'].median()\n",
    "    df['time_since_last_transaction'].fillna(median_val, inplace=True)\n",
    "    print(f\"✅ Filled 'time_since_last_transaction' (median: {median_val:.2f})\")\n",
    "\n",
    "print(f\"Null values after: {df.isnull().sum().sum()}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 3: CONVERT TARGET TO BINARY\n",
    "# ============================================\n",
    "print(\"\\n[3/7] CONVERTING TARGET COLUMN...\")\n",
    "\n",
    "target_col = 'is_fraud'\n",
    "if target_col in df.columns:\n",
    "    # Convert boolean to int\n",
    "    df[target_col] = df[target_col].astype(int)\n",
    "    print(f\"✅ Target '{target_col}' converted: 0=Non-Fraud, 1=Fraud\")\n",
    "    \n",
    "    # Show distribution\n",
    "    fraud_count = df[target_col].sum()\n",
    "    print(f\"   Fraud: {fraud_count:,} ({fraud_count/len(df)*100:.2f}%)\")\n",
    "    print(f\"   Non-Fraud: {len(df)-fraud_count:,} ({(len(df)-fraud_count)/len(df)*100:.2f}%)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 4: ENCODE CATEGORICAL VARIABLES\n",
    "# ============================================\n",
    "print(\"\\n[4/7] ENCODING CATEGORICAL COLUMNS...\")\n",
    "\n",
    "df_encoded = df.copy()\n",
    "object_cols = df_encoded.select_dtypes(include=['object']).columns\n",
    "print(f\"Found {len(object_cols)} categorical columns\")\n",
    "\n",
    "for col in object_cols:\n",
    "    if col != target_col:\n",
    "        le = LabelEncoder()\n",
    "        df_encoded[col] = le.fit_transform(df_encoded[col].astype(str))\n",
    "        print(f\"  ✅ Encoded '{col}' ({df_encoded[col].nunique():,} unique values)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 5: REMOVE HIGH CARDINALITY COLUMNS\n",
    "# ============================================\n",
    "print(\"\\n[5/7] REMOVING HIGH CARDINALITY COLUMNS...\")\n",
    "\n",
    "HIGH_CARDINALITY_THRESHOLD = 100000\n",
    "cols_to_remove = []\n",
    "\n",
    "print(f\"Threshold: >{HIGH_CARDINALITY_THRESHOLD:,} unique values\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "for col in df_encoded.columns:\n",
    "    unique_count = df_encoded[col].nunique()\n",
    "    \n",
    "    if unique_count > HIGH_CARDINALITY_THRESHOLD and col != target_col:\n",
    "        cols_to_remove.append(col)\n",
    "        print(f\"  ❌ REMOVING: {col:<30} ({unique_count:,} unique)\")\n",
    "    elif col != target_col:\n",
    "        print(f\"  ✅ KEEPING:  {col:<30} ({unique_count:,} unique)\")\n",
    "    else:\n",
    "        print(f\"  🎯 TARGET:   {col:<30} ({unique_count:,} unique)\")\n",
    "\n",
    "# Remove columns\n",
    "df_cleaned = df_encoded.drop(columns=cols_to_remove)\n",
    "print(f\"\\n✅ Removed {len(cols_to_remove)} high cardinality columns\")\n",
    "print(f\"Remaining columns: {len(df_cleaned.columns)}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 6: NORMALIZE FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[6/7] NORMALIZING FEATURES...\")\n",
    "\n",
    "# Separate features and target\n",
    "X = df_cleaned.drop(columns=[target_col]).values\n",
