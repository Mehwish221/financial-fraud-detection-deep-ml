   "source": [
    "# TABNET FOR FRAUD DETECTION - CORRECTED VERSION\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"TABNET WITH FULL FEATURE ENGINEERING (CORRECTED)\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import average_precision_score, roc_auc_score, confusion_matrix, accuracy_score, roc_curve, precision_recall_curve\n",
    "from pytorch_tabnet.tab_model import TabNetClassifier\n",
    "import torch\n",
    "import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set random seeds for reproducibility\n",
    "np.random.seed(42)\n",
    "torch.manual_seed(42)\n",
    "\n",
    "# ============================================\n",
    "# STEP 1: LOAD DATA\n",
    "# ============================================\n",
    "print(\"\\n[1/12] LOADING RAW DATA...\")\n",
    "df = pd.read_csv('/Users/apple/Desktop/financial_fraud_detection_dataset.csv')\n",
    "print(f\"✅ Loaded {len(df):,} rows, {len(df.columns)} columns\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 2: CREATE TIME FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[2/12] CREATING TIME FEATURES...\")\n",
    "df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], errors=\"coerce\")\n",
    "df[\"hour\"] = df[\"timestamp\"].dt.hour\n",
    "df[\"day\"] = df[\"timestamp\"].dt.day\n",
    "df[\"day_of_week\"] = df[\"timestamp\"].dt.weekday\n",
    "df[\"month\"] = df[\"timestamp\"].dt.month\n",
    "print(\"✅ Created: hour, day, day_of_week, month\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 3: CONVERT TARGET\n",
    "# ============================================\n",
    "print(\"\\n[3/12] CONVERTING TARGET...\")\n",
    "df[\"is_fraud\"] = df[\"is_fraud\"].astype(int)\n",
    "fraud_count = df['is_fraud'].sum()\n",
    "print(f\"Fraud: {fraud_count:,} ({fraud_count/len(df)*100:.2f}%)\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 4: HANDLE MISSING VALUES\n",
    "# ============================================\n",
    "print(\"\\n[4/12] HANDLING MISSING VALUES...\")\n",
    "imputer = SimpleImputer(strategy=\"mean\")\n",
    "numeric_cols = df.select_dtypes(include=np.number).columns\n",
    "df[numeric_cols] = imputer.fit_transform(df[numeric_cols])\n",
    "\n",
    "if 'fraud_type' in df.columns:\n",
    "    df = df.drop(columns=[\"fraud_type\"])\n",
    "    print(\"✅ Dropped 'fraud_type'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 5: ENCODE CATEGORICAL FEATURES\n",
    "# ============================================\n",
    "print(\"\\n[5/12] ENCODING CATEGORICAL FEATURES...\")\n",
    "for col in df.select_dtypes(include=[\"object\", \"category\"]).columns:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col].astype(str))\n",
    "    print(f\"  Encoded '{col}'\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 6: FEATURE ENGINEERING (Amount features)\n",
    "# ============================================\n",
    "print(\"\\n[6/12] ENGINEERING AMOUNT FEATURES...\")\n",
    "df[\"amount_per_velocity\"] = df[\"amount\"] / (df[\"velocity_score\"] + 1)\n",
    "df[\"amount_log\"] = np.log1p(df[\"amount\"])\n",
    "df[\"amount_to_avg_ratio\"] = df[\"amount\"] / (df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\") + 1)\n",
    "print(\"  Created: amount_per_velocity, amount_log, amount_to_avg_ratio\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 7: FEATURE ENGINEERING (Frequency features)\n",
    "# ============================================\n",
    "print(\"\\n[7/12] ENGINEERING FREQUENCY FEATURES...\")\n",
    "df[\"transaction_per_day\"] = df.groupby([\"sender_account\", \"day\"])[\"amount\"].transform(\"count\")\n",
    "df[\"transaction_gap\"] = df.groupby(\"sender_account\")[\"timestamp\"].diff().dt.total_seconds().fillna(0)\n",
    "print(\"  Created: transaction_per_day, transaction_gap\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 8: FEATURE ENGINEERING (Risk features)\n",
    "# ============================================\n",
    "print(\"\\n[8/12] ENGINEERING RISK FEATURES...\")\n",
    "df[\"is_night_transaction\"] = df[\"hour\"].between(18, 24).astype(int)\n",
    "df[\"is_weekend\"] = df[\"day_of_week\"].isin([5, 6]).astype(int)\n",
    "df[\"is_self_transfer\"] = (df[\"sender_account\"] == df[\"receiver_account\"]).astype(int)\n",
    "print(\"  Created: is_night_transaction, is_weekend, is_self_transfer\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 9: FEATURE ENGINEERING (Network features)\n",
    "# ============================================\n",
    "print(\"\\n[9/12] ENGINEERING NETWORK FEATURES...\")\n",
    "df[\"sender_degree\"] = df.groupby(\"sender_account\")[\"receiver_account\"].transform(\"nunique\")\n",
    "df[\"receiver_degree\"] = df.groupby(\"receiver_account\")[\"sender_account\"].transform(\"nunique\")\n",
    "df[\"sender_total_transaction\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"receiver_total_transaction\"] = df.groupby(\"receiver_account\")[\"amount\"].transform(\"count\")\n",
    "df[\"sender_avg_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\")\n",
    "df[\"sender_std_amount\"] = df.groupby(\"sender_account\")[\"amount\"].transform(\"std\").fillna(0)\n",
    "print(\"  Created: sender/receiver degree, total transactions, avg/std amount\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 10: FEATURE ENGINEERING (Fraud history features)\n",
    "# ============================================\n",
    "print(\"\\n[10/12] ENGINEERING FRAUD HISTORY FEATURES...\")\n",
    "df[\"sender_fraud_transaction\"] = df.groupby(\"sender_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"receiver_fraud_transaction\"] = df.groupby(\"receiver_account\")[\"is_fraud\"].transform(\"sum\")\n",
    "df[\"sender_fraud_percentage\"] = (df[\"sender_fraud_transaction\"] * 100 / (df[\"sender_total_transaction\"] + 1)).round(2)\n",
    "df[\"receiver_fraud_percentage\"] = (df[\"receiver_fraud_transaction\"] * 100 / (df[\"receiver_total_transaction\"] + 1)).round(2)\n",
    "df[\"deviation_squared\"] = df[\"spending_deviation_score\"] ** 2\n",
    "\n",
    "# Drop timestamp\n",
    "df = df.drop(columns=['timestamp'])\n",
    "print(\"\\n✅ Dropped 'timestamp' column\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 11: PREPARE DATA FOR TABNET\n",
    "# ============================================\n",
    "print(\"\\n[11/12] PREPARING DATA FOR TABNET...\")\n",
    "\n",
    "# DOWNSAMPLING (Smaller sample for TabNet)\n",
    "df_majority = df[df['is_fraud'] == 0]\n",
    "df_minority = df[df['is_fraud'] == 1]\n",
    "\n",
    "# Use 15k fraud, 30k non-fraud = 45k total\n",
    "fraud_sample = df_minority.sample(n=min(15000, len(df_minority)), random_state=36)\n",
    "non_fraud_sample = df_majority.sample(n=2 * len(fraud_sample), random_state=36)\n",
    "\n",
    "df_balanced = pd.concat([non_fraud_sample, fraud_sample])\n",
    "df_balanced = df_balanced.sample(frac=1, random_state=36).reset_index(drop=True)\n",
    "\n",
    "print(f\"✅ Balanced dataset for TabNet: {df_balanced.shape}\")\n",
    "print(f\"   Non-Fraud: {(df_balanced['is_fraud']==0).sum():,}\")\n",
    "print(f\"   Fraud: {(df_balanced['is_fraud']==1).sum():,}\")\n",
    "\n",
    "# Normalize features\n",
    "y = df_balanced['is_fraud']\n",
    "X = df_balanced.drop(columns=['is_fraud'])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "X_scaled = pd.DataFrame(X_scaled, columns=X.columns)\n",
    "\n",
    "print(f\"✅ Features normalized: {X_scaled.shape}\")\n",
    "\n",
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_scaled, y, test_size=0.2, random_state=36, stratify=y\n",
    ")\n",
    "X_train, X_val, y_train, y_val = train_test_split(\n",
    "    X_train, y_train, test_size=1/8, random_state=36, stratify=y_train\n",
    ")\n",
    "\n",
    "print(f\"Training set: {X_train.shape}\")\n",
    "print(f\"Validation set: {X_val.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# STEP 12: BUILD AND TRAIN TABNET MODEL\n",
    "# ============================================\n",
    "print(\"\\n[12/12] BUILDING AND TRAINING TABNET MODEL...\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Calculate class weights for imbalance\n",
    "total = len(y_train)\n",
    "fraud_ratio = sum(y_train) / total\n",
    "\n",
    "# Create sample weights for training\n",
    "sample_weights = np.ones(len(y_train))\n",
    "fraud_weight = (1 / fraud_ratio) * 0.5\n",
    "sample_weights[y_train == 1] = fraud_weight\n",
    "\n",
    "# TabNet model\n",
    "tabnet = TabNetClassifier(\n",
    "    n_d=64,                    # Width of decision prediction layer\n",
    "    n_a=64,                    # Width of attention embedding\n",
    "    n_steps=5,                 # Number of sequential attention steps\n",
    "    gamma=1.5,                 # Coefficient for feature selection regularization\n",
    "    lambda_sparse=0.0001,      # Sparse regularization\n",
    "    optimizer_fn=torch.optim.Adam,\n",
    "    optimizer_params=dict(lr=0.01),\n",
    "    mask_type='sparsemax',\n",
    "    scheduler_params=dict(step_size=10, gamma=0.9),\n",
    "    scheduler_fn=torch.optim.lr_scheduler.StepLR,\n",
    "    epsilon=1e-15,\n",
    "    verbose=10,\n",
    "    device_name='cpu'\n",
    ")\n",
    "\n",
    "print(\"\\n🔧 TabNet Model Architecture:\")\n",
    "print(f\"   - Decision layers: 64\")\n",
    "print(f\"   - Attention layers: 64\")\n",
    "print(f\"   - Attention steps: 5\")\n",
    "print(f\"   - Feature selection: Sparsemax\")\n",
    "\n",
    "# Train model - FIXED: removed 'weights' parameter\n",
    "print(\"\\n🔄 Training TabNet model...\")\n",
    "start_time = time.time()\n",
    "\n",
    "tabnet.fit(\n",
    "    X_train.values, y_train.values,\n",
    "    eval_set=[(X_val.values, y_val.values)],\n",
    "    eval_name=['val'],\n",
    "    eval_metric=['auc'],\n",
    "    max_epochs=50,\n",
    "    patience=10,\n",
    "    batch_size=1024,\n",
    "    virtual_batch_size=128,\n",
    "    num_workers=4,\n",
    "    drop_last=False\n",
    ")\n",
    "\n",
    "training_time = time.time() - start_time\n",
    "print(f\"\\n✅ Training complete in {training_time/60:.1f} minutes\")\n",
    "\n",
    "# ============================================\n",
    "# EVALUATE TABNET MODEL\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"TABNET MODEL EVALUATION ON TEST SET\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Predict\n",
    "y_pred_proba = tabnet.predict_proba(X_test.values)[:, 1]\n",
    "y_pred = (y_pred_proba > 0.5).astype(int)\n",
    "\n",
    "# Calculate metrics\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "accuracy = accuracy_score(y_test, y_pred)\n",
    "precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n",
    "aucpr = average_precision_score(y_test, y_pred_proba)\n",
    "auc_roc = roc_auc_score(y_test, y_pred_proba)\n",
    "\n",
    "print(f\"\\n📊 Confusion Matrix:\")\n",
    "print(f\"   True Negatives: {tn:,}\")\n",
    "print(f\"   False Positives: {fp:,}\")\n",
    "print(f\"   False Negatives: {fn:,}\")\n",
    "print(f\"   True Positives: {tp:,}\")\n",
    "\n",
    "print(f\"\\n📈 Performance Metrics:\")\n",
    "print(f\"   {'Accuracy':<15} {accuracy:<12.4f}\")\n",
    "print(f\"   {'Precision':<15} {precision:<12.4f}\")\n",
    "print(f\"   {'Recall':<15} {recall:<12.4f}\")\n",
    "print(f\"   {'F1-Score':<15} {f1:<12.4f}\")\n",
    "print(f\"   {'AUCPR':<15} {aucpr:<12.4f}\")\n",
    "print(f\"   {'ROC-AUC':<15} {auc_roc:<12.4f}\")\n",
    "\n",
    "# ============================================\n",
    "# VISUALIZATIONS\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"GENERATING VISUALIZATIONS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# 1. ROC Curve\n",
    "ax1 = axes[0, 0]\n",
    "fpr, tpr, _ = roc_curve(y_test, y_pred_proba)\n",
    "ax1.plot(fpr, tpr, linewidth=2, color='#2E86AB', label=f'TabNet (AUC = {auc_roc:.4f})')\n",
    "ax1.plot([0, 1], [0, 1], 'k--', linewidth=1, label='Random Classifier')\n",
    "ax1.fill_between(fpr, tpr, alpha=0.3, color='#2E86AB')\n",
    "ax1.set_xlabel('False Positive Rate', fontsize=12)\n",
    "ax1.set_ylabel('True Positive Rate', fontsize=12)\n",
    "ax1.set_title('ROC Curve - TabNet', fontsize=14, fontweight='bold')\n",
    "ax1.legend(loc='lower right')\n",
    "ax1.grid(True, alpha=0.3)\n",
    "ax1.text(0.6, 0.2, f'AUC = {auc_roc:.4f}', fontsize=12, fontweight='bold',\n",
    "         bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
    "\n",
