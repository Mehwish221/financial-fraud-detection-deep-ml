   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score, precision_recall_curve, average_precision_score\n",
    "from imblearn.over_sampling import SMOTE\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# -------------------------------\n",
    "# 1. Load data from correct path\n",
    "# -------------------------------\n",
    "df = pd.read_csv('/Users/apple/Desktop/financial_fraud_detection_dataset.csv')\n",
    "\n",
    "print(\"✅ Data loaded successfully\")\n",
    "print(f\"Shape: {df.shape}\")\n",
    "\n",
    "# -------------------------------\n",
    "# 2. Display basic info\n",
    "# -------------------------------\n",
    "print(\"\\n=== Basic Info ===\")\n",
    "df.info()\n",
    "\n",
    "print(\"\\n=== First 5 rows ===\")\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\n=== Column Names ===\")\n",
    "print(df.columns.tolist())\n",
    "\n",
    "# -------------------------------\n",
    "# 3. Check for missing values\n",
    "# -------------------------------\n",
    "print(\"\\n=== Missing Values ===\")\n",
    "missing = df.isnull().sum()\n",
    "print(missing[missing > 0] if any(missing > 0) else \"✅ No missing values found.\")\n",
    "\n",
    "# -------------------------------\n",
    "# 4. Identify the target column (fraud indicator)\n",
    "# -------------------------------\n",
    "# Common names for fraud column - check which one exists in your data\n",
    "possible_targets = ['is_fraud', 'Class', 'label', 'fraud', 'target', 'TX_FRAUD', 'isFraud']\n",
    "target_col = None\n",
    "\n",
    "for col in possible_targets:\n",
    "    if col in df.columns:\n",
    "        target_col = col\n",
    "        print(f\"\\n✅ Found target column: '{target_col}'\")\n",
    "        break\n",
    "\n",
    "if target_col is None:\n",
    "    print(\"\\n📋 Available columns:\")\n",
    "    for i, col in enumerate(df.columns):\n",
    "        print(f\"  {i}: {col}\")\n",
    "    target_col = input(\"\\n⚠️ Please enter the exact name of the fraud indicator column: \")\n",
    "\n",
    "# -------------------------------\n",
    "# 5. Class distribution (before any processing)\n",
    "# -------------------------------\n",
    "print(\"\\n=== Class Distribution (Original) ===\")\n",
    "print(df[target_col].value_counts())\n",
    "fraud_percentage = (df[target_col].sum() / len(df)) * 100\n",
    "print(f\"Fraud percentage: {fraud_percentage:.2f}%\")\n",
    "print(f\"Non-Fraud percentage: {100-fraud_percentage:.2f}%\")\n",
    "\n",
    "# Plot class distribution\n",
    "plt.figure(figsize=(8,4))\n",
    "plt.subplot(1,2,1)\n",
    "sns.countplot(x=target_col, data=df)\n",
    "plt.title(f\"Class Distribution\\n{fraud_percentage:.2f}% Fraud\")\n",
    "\n",
    "plt.subplot(1,2,2)\n",
    "df[target_col].value_counts().plot.pie(autopct='%1.1f%%', explode=[0, 0.1])\n",
    "plt.title(\"Class Proportions\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# -------------------------------\n",
    "# 6. Remove outliers (only from numeric columns, excluding target)\n",
    "# -------------------------------\n",
    "print(\"\\n=== Removing Outliers (IQR method) ===\")\n",
    "numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "numeric_cols = [col for col in numeric_cols if col != target_col]\n",
    "initial_shape = df.shape\n",
    "\n",
    "outliers_removed = 0\n",
    "for col in numeric_cols:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    before = len(df)\n",
    "    df = df[(df[col] >= lower) & (df[col] <= upper)]\n",
    "    outliers_removed += (before - len(df))\n",
    "\n",
    "print(f\"Original rows: {initial_shape[0]}\")\n",
    "print(f\"Rows after outlier removal: {df.shape[0]}\")\n",
    "print(f\"Removed {outliers_removed} outlier rows\")\n",
    "\n",
    "# -------------------------------\n",
    "# 7. Convert all non-numeric columns to numeric\n",
    "# -------------------------------\n",
    "print(\"\\n=== Converting Non-Numeric Columns ===\")\n",
    "df_encoded = df.copy()\n",
    "non_numeric_cols = df_encoded.select_dtypes(include=['object']).columns\n",
    "\n",
    "for col in non_numeric_cols:\n",
    "    if col != target_col:\n",
    "        le = LabelEncoder()\n",
    "        df_encoded[col] = le.fit_transform(df_encoded[col].astype(str))\n",
    "        print(f\"  ✅ Encoded '{col}' (unique values: {len(le.classes_)})\")\n",
    "\n",
    "# Ensure target is numeric (0 and 1)\n",
    "if df_encoded[target_col].dtype == 'object':\n",
    "    # Map common fraud indicators\n",
    "    mapping = {'fraud': 1, 'not_fraud': 0, 'Fraud': 1, 'Not Fraud': 0, \n",
    "               'Yes': 1, 'No': 0, 'True': 1, 'False': 0}\n",
    "    df_encoded[target_col] = df_encoded[target_col].map(mapping).fillna(0).astype(int)\n",
    "    print(f\"  ✅ Converted target column to numeric\")\n",
    "\n",
    "# -------------------------------\n",
    "# 8. Normalize numeric features\n",
    "# -------------------------------\n",
    "print(\"\\n=== Normalizing Numeric Features ===\")\n",
    "features = [col for col in df_encoded.columns if col != target_col]\n",
    "scaler = StandardScaler()\n",
    "df_encoded[features] = scaler.fit_transform(df_encoded[features])\n",
    "print(f\"✅ StandardScaler applied to {len(features)} features\")\n",
    "\n",
    "# -------------------------------\n",
    "# 9. Prepare X and y\n",
    "# -------------------------------\n",
    "X = df_encoded[features].values\n",
    "y = df_encoded[target_col].values\n",
    "\n",
    "print(f\"\\nFinal feature matrix shape: {X.shape}\")\n",
    "print(f\"Final target vector shape: {y.shape}\")\n",
    "print(f\"Class distribution after processing: {np.bincount(y)}\")\n",
    "\n",
    "# -------------------------------\n",
    "# 10. Apply K-Fold (k=10) with SMOTE on training set only (k=1,5,27)\n",
    "# -------------------------------\n",
    "kfold = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n",
    "smote_neighbors = [1, 5, 27]\n",
    "results = {}\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"STARTING CROSS-VALIDATION WITH SMOTE\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "for k_neighbors in smote_neighbors:\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"🔁 SMOTE with k_neighbors = {k_neighbors}\")\n",
    "    print('='*50)\n",
    "    \n",
    "    fold_auc = []\n",
    "    fold_auprc = []\n",
    "    fold_models = []\n",
    "    \n",
    "    for fold, (train_idx, val_idx) in enumerate(kfold.split(X, y), 1):\n",
    "        X_train, X_val = X[train_idx], X[val_idx]\n",
    "        y_train, y_val = y[train_idx], y[val_idx]\n",
    "        \n",
    "        # Apply SMOTE only on training set\n",
    "        print(f\"  Fold {fold}: Original training set size: {len(y_train)}, Fraud: {sum(y_train)}\")\n",
    "        smote = SMOTE(k_neighbors=min(k_neighbors, sum(y_train)-1), random_state=42)  # Adjust k if needed\n",
    "        X_train_resampled, y_train_resampled = smote.fit_resample(X_train, y_train)\n",
    "        print(f\"         After SMOTE: {len(y_train_resampled)}, Fraud: {sum(y_train_resampled)}\")\n",
    "        \n",
    "        # Train RandomForest classifier\n",
    "        clf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1, class_weight='balanced')\n",
    "        clf.fit(X_train_resampled, y_train_resampled)\n",
    "        \n",
    "        # Predict on validation set\n",
    "        y_pred = clf.predict(X_val)\n",
    "        y_proba = clf.predict_proba(X_val)[:, 1]\n",
    "        \n",
    "        # Calculate metrics\n",
    "        auc = roc_auc_score(y_val, y_proba)\n",
    "        auprc = average_precision_score(y_val, y_proba)\n",
    "        fold_auc.append(auc)\n",
    "        fold_auprc.append(auprc)\n",
    "        fold_models.append(clf)\n",
    "        \n",
    "        if fold == 1:  # Show detailed report only for first fold\n",
    "            print(f\"\\n  --- Fold {fold} Detailed Results ---\")\n",
    "            print(f\"  ROC-AUC: {auc:.4f}\")\n",
    "            print(f\"  AUPRC: {auprc:.4f}\")\n",
    "            print(f\"  Classification Report:\")\n",
    "            print(classification_report(y_val, y_pred, target_names=['Non-Fraud', 'Fraud']))\n",
    "    \n",
    "    print(f\"\\n  ✅ Results for k={k_neighbors}:\")\n",
    "    print(f\"     Mean ROC-AUC: {np.mean(fold_auc):.4f} (+/- {np.std(fold_auc):.4f})\")\n",
    "    print(f\"     Mean AUPRC: {np.mean(fold_auprc):.4f} (+/- {np.std(fold_auprc):.4f})\")\n",
    "    results[k_neighbors] = {'ROC-AUC': np.mean(fold_auc), 'AUPRC': np.mean(fold_auprc)}\n",
    "\n",
    "# -------------------------------\n",
    "# 11. Summary comparison\n",
    "# -------------------------------\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"📊 FINAL SUMMARY: SMOTE k_neighbors vs Performance\")\n",
    "print(\"=\"*60)\n",
    "print(f\"{'k_neighbors':<12} {'ROC-AUC':<12} {'AUPRC':<12}\")\n",
    "print(\"-\"*36)\n",
    "for k in sorted(results.keys()):\n",
    "    print(f\"{k:<12} {results[k]['ROC-AUC']:<12.4f} {results[k]['AUPRC']:<12.4f}\")\n",
    "\n",
    "# Plot comparison\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "k_values = list(results.keys())\n",
    "auc_values = [results[k]['ROC-AUC'] for k in k_values]\n",
    "auprc_values = [results[k]['AUPRC'] for k in k_values]\n",
    "\n",
    "ax1.plot(k_values, auc_values, marker='o', linewidth=2, markersize=8)\n",
    "ax1.set_xlabel(\"SMOTE k_neighbors\", fontsize=12)\n",
    "ax1.set_ylabel(\"ROC-AUC Score\", fontsize=12)\n",
    "ax1.set_title(\"Effect of SMOTE k_neighbors on ROC-AUC\", fontsize=14)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "ax2.plot(k_values, auprc_values, marker='s', linewidth=2, markersize=8, color='green')\n",
    "ax2.set_xlabel(\"SMOTE k_neighbors\", fontsize=12)\n",
    "ax2.set_ylabel(\"AUPRC Score\", fontsize=12)\n",
    "ax2.set_title(\"Effect of SMOTE k_neighbors on AUPRC\", fontsize=14)\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"✅ ANALYSIS COMPLETE\")\n",
    "print(\"=\"*60)\n",
    "print(\"\\nRecommendations:\")\n",
    "best_k = max(results.keys(), key=lambda k: results[k]['ROC-AUC'])\n",
    "print(f\"• Best k_neighbors based on ROC-AUC: {best_k}\")\n",
    "print(f\"• For highly imbalanced data (4% fraud), AUPRC is more informative than ROC-AUC\")\n",
    "print(\"• Consider also trying: Ensemble methods, XGBoost, or Neural Networks for better results\")"
