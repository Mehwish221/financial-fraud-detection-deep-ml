    "    {'name': 'RBF SVM (C=1)', 'kernel': 'rbf', 'C': 1.0},\n",
    "    {'name': 'RBF SVM (C=10)', 'kernel': 'rbf', 'C': 10},\n",
    "]\n",
    "\n",
    "svm_results = {}\n",
    "\n",
    "for config in svm_configs:\n",
    "    print(f\"\\n🔁 Testing {config['name']}\")\n",
    "    print(\"-\" * 40)\n",
    "    \n",
    "    start_time = time.time()\n",
    "    \n",
    "    svm = SVC(kernel=config['kernel'], C=config['C'], \n",
    "              probability=True, random_state=36, class_weight='balanced')\n",
    "    svm.fit(X_train, y_train)\n",
    "    \n",
    "    y_val_pred_proba = svm.predict_proba(X_val)[:, 1]\n",
    "    y_test_pred_proba = svm.predict_proba(X_test)[:, 1]\n",
    "    y_test_pred = svm.predict(X_test)\n",
    "    \n",
    "    val_aucpr = average_precision_score(y_val, y_val_pred_proba)\n",
    "    val_auc_roc = roc_auc_score(y_val, y_val_pred_proba)\n",
    "    test_aucpr = average_precision_score(y_test, y_test_pred_proba)\n",
