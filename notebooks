    "df[\"amount_to_avg_ratio\"] = df[\"amount\"] / (df.groupby(\"sender_account\")[\"amount\"].transform(\"mean\") + 1)\n",
    "print(\"  Created: amount_per_velocity, amount_log, amount_to_avg_ratio\")\n",
