    "print(f\"Validation set: {X_val.shape}\")\n",
    "print(f\"Test set: {X_test.shape}\")\n",
    "\n",
    "# ============================================\n",
    "# TRAIN XGBOOST\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"TRAINING XGBOOST\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "scale_pos_weight = (y_train == 0).sum() / (y_train == 1).sum()\n",
    "\n",
    "xgb_model = XGBClassifier(\n",
    "    n_estimators=300,\n",
    "    objective='binary:logistic',\n",
    "    tree_method='hist',\n",
    "    max_depth=12,\n",
    "    learning_rate=0.05,\n",
    "    reg_lambda=3.6,\n",
    "    reg_alpha=3.6,\n",
    "    scale_pos_weight=scale_pos_weight,\n",
    "    eval_metric=['aucpr'],\n",
    "    subsample=0.8,\n",
    "    n_jobs=-1,\n",
    "    random_state=36\n",
    ")\n",
    "\n",
    "print(\"Training model ...\")\n",
    "eval_set = [(X_train, y_train), (X_val, y_val)]\n",
    "\n",
    "start_time = time.time()\n",
    "xgb_model.fit(X_train, y_train, eval_set=eval_set, verbose=50)\n",
    "train_time = time.time() - start_time\n",
    "\n",
    "print(f\"\\n✅ Training complete in {train_time/60:.1f} minutes\")\n",
    "\n",
    "# ============================================\n",
    "# EVALUATE ON TEST SET\n",
    "# ============================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"EVALUATION ON TEST SET\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "y_pred_proba = xgb_model.predict_proba(X_test)[:, 1]\n",
    "y_pred = xgb_model.predict(X_test)\n",
    "\n",
    "test_aucpr = average_precision_score(y_test, y_pred_proba)\n",
    "test_auc_roc = roc_auc_score(y_test, y_pred_proba)\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
